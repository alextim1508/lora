<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFFFFF"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/deviceNameAddressLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Имя устройства (AA:BB:CC:DD:EE:FF)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/deviceStatusLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Статус: --"
        android:textSize="12sp"
        android:textColor="#000000"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/deviceLoraNameLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LoRa: --"
        android:textSize="12sp"
        android:textColor="#000000"
        android:layout_marginBottom="2dp" />

    <!-- Два графика зависимости количества сообщений от времени за последнюю минуту, с
         разрешением в одну секунду, один под другим: отправленные (синий) и полученные (зеленый).
         Данные заполняются из DataFragment#updateDevicesInfoDisplay() через
         DeviceData#sentHistoryBuckets()/receivedHistoryBuckets(). -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Отправлено, последние 60с:"
        android:textSize="11sp"
        android:textColor="#666666"
        android:layout_marginBottom="2dp" />

    <com.alextim.lora.ui.util.MessageCountChartView
        android:id="@+id/deviceSentChart"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Получено, последние 60с:"
        android:textSize="11sp"
        android:textColor="#666666"
        android:layout_marginBottom="2dp" />

    <com.alextim.lora.ui.util.MessageCountChartView
        android:id="@+id/deviceReceivedChart"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/deviceStatsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Статистика: --"
        android:textSize="12sp"
        android:textColor="#000000"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/deviceRecentStatsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Последние 10с - Отправлено: -- | Получено: --"
        android:textSize="12sp"
        android:textColor="#000000"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/deviceRssiLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RSSI: --"
        android:textSize="12sp"
        android:textColor="#000000"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/deviceLastMessageLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Последнее сообщение: --"
        android:textSize="12sp"
        android:textColor="#000000" />

</LinearLayout>